
# There is no parameter to ignore "*_unused" signals like W528. Instead add a waiver if a signal name ends with "_unused".
waive_lint -tag HangingInstOutput-ML -add global_HangingInstOutput -filter {(Signal =~ "*_unused*" AND String1 =~ "unconnected")}

# Spyglass 2021 renamed their category "Signal" to "SignalNet", so this is the new waiver similar to the waiver above.
waive_lint -tag HangingInstOutput-ML -append global_HangingInstOutput -filter {(SignalNet =~ "*_unused*" AND String1 =~ "unconnected")}

# Not all elements of array '[Signal]' are 'read' [Hierarchy: '[HIERARCHY]'].
# Waived when signal ends with "_unused" per existing naming convention to specify intentionally unused signals.
waive_lint -tag W111 -add global_W111 -filter {(Signal =~ "*_unused*")}
waive_lint -tag W111 -append global_W111 -filter {(Statement =~ "*SignalUsageReport*")}
waive_lint -tag W528 -append global_W111 -filter {(Statement =~ "*SignalUsageReport*")}


waive_violation -add {STARC05-2_10_3_2b_sa_2777}  -comment {Address range accessing CSRs is already checked by checker block, so the address offset will always fit in LHS size.}  -filter {(Module == "sinc_cmu_axi_sub_wrap") AND (Statement == "    assign csr_addr = sub_engn_addr_o - REG_BASE_ADDR;")}  -app { lint } -tag { STARC05-2.10.3.2b_sa }
