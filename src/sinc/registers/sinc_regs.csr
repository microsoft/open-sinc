    register {

        property title = "Latency counter lower bits register";
        property description = "Lower 32b of the latency counter value. The latency counter counts the number of clock cycles \
        from when SInC initiated the DMA read to fetch block data to when last byte of block data is received. \
        \nNote that the counter accumulates the count value for every cache-miss. \
        \nLatency counter is enabled only when lat_cntr_en is set in Performance counters control register. \
        Counter is reset when lat_cntr_clr is set. It stops counting if it reaches the max value.";
        property register_output_port   = false;
        property register_written_port  = false;

        field_template lat_cntr_lower (title = "Latency counter lower bits",
			desc = "Lower 32b of the latency counter value",
			size = 32,
			field_type = "status",
			write_access = false,
            read_access = true,
			load_enable = false,
			read_effect = "none",
			reset_value = 32'h0,
			reset = "reset",
			input_value = false,
            trigger_port = false);
    
    } lat_cntr_lower;

    register {

        property title = "Latency counter upper bits register";
        property description = "Upper 32b of the latency counter value. The latency counter counts the number of clock cycles \
        from when SInC initiated the DMA read to fetch block data to when last byte of block data is received. \
        \nNote that the counter accumulates the count value for every cache-miss. \
        \nLatency counter is enabled only when lat_cntr_en is set in Performance counters control register. \
        Counter is reset when lat_cntr_clr is set. It stops counting if it reaches the max value.";
        property register_output_port   = false;
        property register_written_port  = false;

