    register {

        property title = "AES test control register";
        property description = "This register enables AES in test mode and controls its input/output parameters.";
        property register_output_port   = true;

        field_template mode (title = "AES mode",
			desc = "Sets AES mode when cfg_key_iv_vld is set.\
            \n4'h1 - ECB\
            \n4'h7 - GCM\
            \nWrite to this field is ignored if cfg_key_iv_rdy is not set.",
			size = 4,
			field_type = "configuration",
			write_access = true,
            read_access = true,
			load_enable = false,
            write_enable = true,
			read_effect = "none",
			reset_value = 4'h0,
			reset = "reset",
			input_value = false,
            trigger_port = false);

        field_template dir (title = "AES direction",
			desc = "Sets AES direction when cfg_key_iv_vld is set.\
            \n1 - Ecnrypt\
            \n0 - Decrypt\
            \nWrite to this field is ignored if cfg_key_iv_rdy is not set.",
			size = 1,
			field_type = "configuration",
			write_access = true,
            read_access = true,
			load_enable = false,
            write_enable = true,
			read_effect = "none",
			reset_value = 1'h0,
			reset = "reset",
			input_value = false,
            trigger_port = false);

        field_template key_len (title = "AES key length",
			desc = "Sets AES key length when cfg_key_iv_vld is set.\
            \n2'h0 - Reserved\
            \n2'h1 - Reserved\
            \n2'h2 - 256b key\
            \n2'h3 - Reserved\
            \nWrite to this field is ignored if cfg_key_iv_rdy is not set.",
			size = 2,
			field_type = "configuration",
			write_access = true,
            read_access = true,
			load_enable = false,
            write_enable = true,
			read_effect = "none",
			reset_value = 2'h0,
			reset = "reset",
			input_value = false,
            trigger_port = false);

        field_template reuse_key (title = "Reuse AES key",
			desc = "When set along with cfg_key_iv_vld bit, SInC won't read a new key from KSU and \
            keep using previously loaded key.\
            \nWrite to this field is ignored if cfg_key_iv_rdy is not set.",
			size = 1,
			field_type = "configuration",
			write_access = true,
            read_access = true,
			load_enable = false,
            write_enable = true,
			read_effect = "none",
			reset_value = 1'h0,
			reset = "reset",
			input_value = false,
            trigger_port = false);

        field_template cfg_key_iv_vld (title = "AES config, key and IV valid",
			desc = "Wait for cfg_key_iv_rdy = 1. Once cfg_key_iv_rdy is set, setting this bit will do following things. \
            \n1. SInC loads mode and dir in AES.\
            \n2. SInC reads the key from KSU key slot # based on value in block encryption key register, \
            stores it locally and loads it in AES.\
            \nIf reuse_key is set, SInC skips reading the key from KSU and reuses locally stored key (that was fetched earlier).\
            \n3. SInC loads IV from IV nonce* registes in AES.\
            \nHW clears this bit after one clock cycle of cfg_key_iv_vld and cfg_key_iv_rdy handshake.\
            \nWrite to this field is ignored if cfg_key_iv_rdy is not set.",
			size = 1,
			field_type = "configuration",
			write_access = true,
            read_access = true,
			load_enable = true,
            write_enable = true,
			read_effect = "none",
			reset_value = 1'h0,
			reset = "reset",
			input_value = true,
            trigger_port = false);

        field_template data_in_vld (title = "Test data input valid",
			desc = "Wait for data_in_rdy = 1. Once data_in_rdy is set, setting this field causes SInC to load data from AES test data in 0..3 as AES input block.\
            \nHW clears this bit after one clock cycle of data_in_vld and data_in_rdy handshake.\
            \nWrite to this field is ignored if data_in_rdy is not set.",
			size = 1,
			field_type = "configuration",
			write_access = true,
            read_access = true,
			load_enable = true,
            write_enable = true,
			read_effect = "none",
			reset_value = 1'h0,
			reset = "reset",
			input_value = true,
            trigger_port = false);

        field_template data_in_byte_cnt (title = "Test data input byte count",
			desc = "When set along with data_in_vld and data_in_last is set, this field indicates how many bytes are valid in AES test data in 0..3.\
            \nWrite to this field is ignored if data_in_rdy is not set.",
			size = 5,
			field_type = "configuration",
			write_access = true,
            read_access = true,
			load_enable = false,
            write_enable = true,
			read_effect = "none",
			reset_value = 4'h0,
			reset = "reset",
			input_value = false,
            trigger_port = false);

        field_template data_in_last (title = "Last test data input",
			desc = "When set along with data_in_vld, it indicates the input data block is the last input block.\
            \nWrite to this field is ignored if data_in_rdy is not set.",
			size = 1,
			field_type = "configuration",
			write_access = true,
            read_access = true,
			load_enable = false,
            write_enable = true,
			read_effect = "none",
			reset_value = 1'h0,
			reset = "reset",
			input_value = false,
            trigger_port = false);

        field_template data_in_aad_sel (title = "Data in select input",
			desc = "When set along with data_in_vld, it indicates whether the input data block is PT/CT or AAD.\
            This version does not support AAD.\
            \n1 - Reserved\
            \n0 - PT/CT\
            \nWrite to this field is ignored if data_in_rdy is not set.",
			size = 1,
			field_type = "configuration",
			write_access = true,
            read_access = true,
			load_enable = false,
            write_enable = true,
			read_effect = "none",
			reset_value = 1'h0,
			reset = "reset",
			input_value = false,
            trigger_port = false);

        field_template data_out_ack (title = "Test data output acknowledge",
			desc = "Wait for data_out_vld = 1. Once data_out_vld is set, setting this bit indicates that the AES test data out 0..3 registers have been read by FW. \
            \nHW clears this field after one clock cycle data_out_vld and data_out_ack handshake.\
            \nWrite to this field is ignored if data_out_vld is not set.",
			size = 1,
			field_type = "configuration",
			write_access = true,
            read_access = true,
			load_enable = false,
            write_enable = true,
			read_effect = "none",
			reset_value = 1'h0,
			reset = "reset",
            clear = true,
			input_value = false,
            trigger_port = false);
    
    } aes_test_ctrl;

    register {

        property title = "AES test status register";
        property description = "This register contains the status of AES and its parameters while AES is in test mode.";
        property register_output_port   = true;
        property register_written_port  = false;

        field_template cfg_key_iv_rdy (title = "AES config, key and IV ready",
			desc = "Indicates that AES is ready to receive AES config, key and IV in AES test mode. \
            \nIf this field is set, cfg_key_iv_vld field can be set to load new configuration, key and IV into AES.",
			size = 1,
			field_type = "status",
			write_access = false,
            read_access = true,
			load_enable = false,
			read_effect = "none",
			reset_value = 1'h0,
			reset = "reset",
			input_value = false,
            trigger_port = false);

        field_template data_in_rdy (title = "Data input ready",
			desc = "Indicates that AES is ready to receive input data block in AES test mode. \
            If this field is set, data_in_vld can be set to load new input block.",
			size = 1,
			field_type = "status",
			write_access = false,
            read_access = true,
			load_enable = false,
			read_effect = "none",
			reset_value = 1'h0,
			reset = "reset",
			input_value = false,
            trigger_port = false);

        field_template data_out_vld (title = "Data output valid",
			desc = "Indicates that AES test data out 0..3 registers contain valid data. \
            \nIf this field is set, data_out_ack field can be set after reading the data out 0..3 \
            registers to acknowledge that output test data has been read.",
			size = 1,
			field_type = "configuration",
			write_access = false,
            read_access = true,
			load_enable = true,
			read_effect = "none",
			reset_value = 1'h0,
			reset = "reset",
            clear = true,
			input_value = true,
            trigger_port = false);

        field_template tag_out (title = "Mux select for AES test data out 0..3 registers",
			desc = "Indicates whether the AES test data out 0..3 registers contain output data block or authentication tag.\
            \n0 - Output data block\
            \n1 - Authentication tag",
			size = 1,
			field_type = "configuration",
			write_access = false,
            read_access = true,
			load_enable = true,
			read_effect = "none",
			reset_value = 1'h0,
			reset = "reset",
            clear = true,
			input_value = true,
            trigger_port = false);
    
    } aes_test_status;

    register {

        property title = "Encrypt block status register";
        property description = "Shows status of encrypt block command";
        property register_output_port   = false;
        property register_written_port  = false;

        field_template num_of_blocks_encr (title = "Number of block successfully encrypted",
			desc = "Shows number of blocks successfully encrypted before encrypt block command failed. May be used for debug purposes.\
            \nThis field remains unchanged if encrypt command successfully completes.",
			size = 12,
			field_type = "configuration",
			write_access = false,
            read_access = true,
			load_enable = true,
			read_effect = "clear",
			reset_value = 12'h0,
			reset = "reset",
			input_value = true,
            trigger_port = false);
    
    } encr_block_status;

